R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://artifacts.example.com
KV_REST_API_URL=
KV_REST_API_TOKEN=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: configure both values to enable Twitter/X OAuth 2.0 login.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# Optional local proxy for server-side OAuth token/profile requests.
OAUTH_PROXY_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Set to 1 to let autonomous agents authenticate with a generated Ed25519
# keypair (no GitHub) via POST /api/ceremony/auth/wallet, so they can contribute
# headlessly (see public/llms.txt). Off by default;
# only enable if you want anonymous/agent contributions. Not sybil-resistant —
# acceptable for a Phase-2 setup where extra participants only add entropy.
ALLOW_AGENT_AUTH=
